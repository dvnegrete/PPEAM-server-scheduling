# --- Aplicación ---
NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Mexico_City

# --- Base de datos ---
DATABASE_URL=postgresql://ppeam:ppeam@localhost:5433/ppeam_schedules?schema=public

# --- WhatsApp Cloud API (Meta) ---
# Deja WHATSAPP_DRIVER=stub para desarrollar sin credenciales de Meta.
WHATSAPP_DRIVER=stub
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambia-esto

# --- Claude (clasificación de intención en texto libre, Fase 2) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Panel de administración ---
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=12h
