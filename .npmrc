# Las herramientas de build viven en devDependencies (el CLI de Nest, TypeScript,
# Prisma). Con NODE_ENV=production —que en producción hace falta— npm toma
# `omit=dev` por omisión y la instalación se las salta, así que el build se queda
# sin compilador. Declararlo aquí lo deja resuelto en cualquier entorno, sin
# depender de variables configuradas fuera del repositorio.
include=dev
